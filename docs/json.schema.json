{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PascalKrausch/godist/docs/json.schema.json",
  "title": "godist fit report",
  "description": "Vertrag der JSON-Ausgabe von distfit -all -format=json. Version siehe schema_version. Neue optionale Felder sind nicht-brechend; Umbenennungen oder Entfernungen erhöhen schema_version.",
  "type": "object",
  "required": [
    "schema_version",
    "input",
    "sample_size",
    "discarded",
    "candidates",
    "descriptive",
    "models",
    "failures"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "input": {
      "type": "string"
    },
    "column": {
      "type": "string",
      "description": "Nur vorhanden, wenn eine Spalte gewählt wurde."
    },
    "sample_size": {
      "type": "integer",
      "minimum": 0
    },
    "discarded": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "integer",
      "minimum": 0
    },
    "best_distribution": {
      "type": "string",
      "description": "Name des Modells mit dem kleinsten AIC. Nur vorhanden, wenn mindestens ein Modell angepasst wurde."
    },
    "total_duration_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Walltime aller Fits zusammen in Millisekunden (parallel). Optional."
    },
    "dip_test": {
      "type": "object",
      "required": ["dip", "p_value", "simulations", "seed"],
      "properties": {
        "dip": { "type": "number", "minimum": 0, "maximum": 0.25 },
        "p_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "simulations": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer", "minimum": 0 }
      },
      "description": "Hartigan-Dip-Test auf die Eingabestichprobe (Unimodalität). Nur vorhanden bei -dip."
    },
    "descriptive": {
      "type": "object",
      "required": ["n", "mean", "median", "variance", "std_dev", "min", "q1", "q3", "max", "skewness", "kurtosis", "ties", "tie_rate", "max_tie_run"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "mean": { "$ref": "#/$defs/nullableNumber" },
        "median": { "$ref": "#/$defs/nullableNumber" },
        "variance": { "$ref": "#/$defs/nullableNumber" },
        "std_dev": { "$ref": "#/$defs/nullableNumber" },
        "min": { "$ref": "#/$defs/nullableNumber" },
        "q1": { "$ref": "#/$defs/nullableNumber" },
        "q3": { "$ref": "#/$defs/nullableNumber" },
        "max": { "$ref": "#/$defs/nullableNumber" },
        "skewness": { "$ref": "#/$defs/nullableNumber" },
        "kurtosis": { "$ref": "#/$defs/nullableNumber" },
        "ties": { "type": "integer", "minimum": 0, "description": "Anzahl der Werte, die ein bereits aufgetretenes Duplikat sind (n minus Anzahl verschiedener Werte; exakte Float-Gleichheit)." },
        "tie_rate": { "$ref": "#/$defs/nullableNumber", "description": "ties / n; null bei n = 0." },
        "max_tie_run": { "type": "integer", "minimum": 0, "description": "Länge des längsten Laufs gleicher Werte; der ECDF-Sprung MaxTieRun/n." }
      }
    },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "error"],
        "properties": {
          "name": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "nullableNumber": {
      "type": ["number", "null"],
      "description": "null, wenn die Kennzahl nicht berechenbar ist (NaN/Inf)."
    },
    "model": {
      "type": "object",
      "required": ["name", "params", "aic", "delta_aic", "bic", "ks_statistic", "rmse"],
      "properties": {
        "name": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "aic": { "type": "number" },
        "delta_aic": { "type": "number", "minimum": 0 },
        "bic": { "type": "number" },
        "ks_statistic": { "type": "number", "minimum": 0 },
        "rmse": { "type": "number", "minimum": 0 },
        "duration_ms": { "type": "number", "minimum": 0, "description": "Walltime des Fits in Millisekunden. Optional." },
        "bootstrap": {
          "$ref": "#/$defs/bootstrapResult",
          "description": "Bootstrap-Auswertung; nur vorhanden, wenn -bootstrap > 0 für dieses Modell lief."
        }
      }
    },
    "bootstrapResult": {
      "type": "object",
      "required": ["method", "requested", "replicates", "failed", "level", "seed", "params", "metrics"],
      "properties": {
        "method": { "enum": ["nonparametric", "parametric"] },
        "requested": { "type": "integer", "minimum": 1 },
        "replicates": { "type": "integer", "minimum": 0, "description": "Erfolgreich ausgewertete Wiederholungen." },
        "failed": { "type": "integer", "minimum": 0, "description": "Fehlgeschlagene Wiederholungen (Fit oder Metrik)." },
        "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "seed": { "type": "integer", "minimum": 0, "description": "Wirksamer Seed; reproduzierbar via -bootstrap-seed." },
        "duration_ms": { "type": "number", "minimum": 0, "description": "Walltime aller Replicates zusammen. Optional." },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameterCI" }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/metricCI" },
          "description": "Schluessel: aic, bic, ks, rmse."
        }
      }
    },
    "parameterCI": {
      "type": "object",
      "required": ["name", "mean", "lo", "hi"],
      "properties": {
        "name": { "type": "string" },
        "mean": { "type": "number" },
        "lo": { "type": "number" },
        "hi": { "type": "number" }
      }
    },
    "metricCI": {
      "type": "object",
      "required": ["mean", "lo", "hi"],
      "properties": {
        "mean": { "type": "number" },
        "lo": { "type": "number" },
        "hi": { "type": "number" }
      }
    }
  }
}
